project.manifest = manifest.xml
base.sourcePath = source

# The Forerunner 255 family has no vector fonts, and its smallest system font
# (bold Roboto) makes register labels too wide for the 218 px 255S. These
# watches get bundled Roboto Condensed bitmap fonts for the labels instead
# (resources-labels-*, generated by tools/bmfont.swift); code for them is
# annotated :labelFonts, the system-font fallback :systemLabelFonts.
base.excludeAnnotations = labelFonts
fr255.resourcePath = $(fr255.resourcePath);resources-labels-260
fr255.excludeAnnotations = systemLabelFonts
fr255m.resourcePath = $(fr255m.resourcePath);resources-labels-260
fr255m.excludeAnnotations = systemLabelFonts
fr255s.resourcePath = $(fr255s.resourcePath);resources-labels-218
fr255s.excludeAnnotations = systemLabelFonts
fr255sm.resourcePath = $(fr255sm.resourcePath);resources-labels-218
fr255sm.excludeAnnotations = systemLabelFonts
