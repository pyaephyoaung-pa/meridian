<settings>
    <!-- Group descriptions are the only place Garmin Connect shows help text.
         The Gauges help explains press-and-hold, the short labels and the
         no-reading placeholder. -->
    <group id="gauges" title="@Strings.GaugesTitle" description="@Strings.GaugesHelp">
        <setting propertyKey="@Properties.GaugeLeft" title="@Strings.GaugeLeftTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.MetricHeartRate</listEntry>
                <listEntry value="1">@Strings.MetricBodyBattery</listEntry>
                <listEntry value="2">@Strings.MetricBattery</listEntry>
                <listEntry value="3">@Strings.MetricStress</listEntry>
                <listEntry value="4">@Strings.MetricSteps</listEntry>
                <listEntry value="5">@Strings.MetricFloors</listEntry>
                <listEntry value="6">@Strings.MetricIntensity</listEntry>
                <listEntry value="7">@Strings.MetricCalories</listEntry>
                <listEntry value="8">@Strings.MetricPulseOx</listEntry>
                <listEntry value="9">@Strings.MetricRespiration</listEntry>
                <listEntry value="10">@Strings.MetricSleep</listEntry>
                <listEntry value="11">@Strings.MetricDistance</listEntry>
                <listEntry value="12">@Strings.MetricActiveCalories</listEntry>
                <listEntry value="13">@Strings.MetricAltitude</listEntry>
                <listEntry value="14">@Strings.MetricPressure</listEntry>
                <listEntry value="15">@Strings.MetricTemperature</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.GaugeRight" title="@Strings.GaugeRightTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.MetricHeartRate</listEntry>
                <listEntry value="1">@Strings.MetricBodyBattery</listEntry>
                <listEntry value="2">@Strings.MetricBattery</listEntry>
                <listEntry value="3">@Strings.MetricStress</listEntry>
                <listEntry value="4">@Strings.MetricSteps</listEntry>
                <listEntry value="5">@Strings.MetricFloors</listEntry>
                <listEntry value="6">@Strings.MetricIntensity</listEntry>
                <listEntry value="7">@Strings.MetricCalories</listEntry>
                <listEntry value="8">@Strings.MetricPulseOx</listEntry>
                <listEntry value="9">@Strings.MetricRespiration</listEntry>
                <listEntry value="10">@Strings.MetricSleep</listEntry>
                <listEntry value="11">@Strings.MetricDistance</listEntry>
                <listEntry value="12">@Strings.MetricActiveCalories</listEntry>
                <listEntry value="13">@Strings.MetricAltitude</listEntry>
                <listEntry value="14">@Strings.MetricPressure</listEntry>
                <listEntry value="15">@Strings.MetricTemperature</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.GaugeBottom" title="@Strings.GaugeBottomTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.MetricHeartRate</listEntry>
                <listEntry value="1">@Strings.MetricBodyBattery</listEntry>
                <listEntry value="2">@Strings.MetricBattery</listEntry>
                <listEntry value="3">@Strings.MetricStress</listEntry>
                <listEntry value="4">@Strings.MetricSteps</listEntry>
                <listEntry value="5">@Strings.MetricFloors</listEntry>
                <listEntry value="6">@Strings.MetricIntensity</listEntry>
                <listEntry value="7">@Strings.MetricCalories</listEntry>
                <listEntry value="8">@Strings.MetricPulseOx</listEntry>
                <listEntry value="9">@Strings.MetricRespiration</listEntry>
                <listEntry value="10">@Strings.MetricSleep</listEntry>
                <listEntry value="11">@Strings.MetricDistance</listEntry>
                <listEntry value="12">@Strings.MetricActiveCalories</listEntry>
                <listEntry value="13">@Strings.MetricAltitude</listEntry>
                <listEntry value="14">@Strings.MetricPressure</listEntry>
                <listEntry value="15">@Strings.MetricTemperature</listEntry>
            </settingConfig>
        </setting>
    </group>
    <group id="appearance" title="@Strings.SettingsGroupTitle" description="@Strings.SettingsHelp">
        <setting propertyKey="@Properties.AccentColor" title="@Strings.AccentTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.AccentChampagne</listEntry>
                <listEntry value="1">@Strings.AccentIvory</listEntry>
                <listEntry value="2">@Strings.AccentSky</listEntry>
                <listEntry value="3">@Strings.AccentRose</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.ShowSeconds" title="@Strings.ShowSecondsTitle">
            <settingConfig type="boolean"/>
        </setting>
    </group>
</settings>
